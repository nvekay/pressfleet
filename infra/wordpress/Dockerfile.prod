# A demo site for production: WordPress with WP-CLI and the PressFleet plugin and theme built in.
# Build from the repository root:
#   docker build -f infra/wordpress/Dockerfile.prod .
FROM node:24-alpine AS block
RUN corepack enable
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY wp/plugins/pressfleet-connector/package.json wp/plugins/pressfleet-connector/
RUN pnpm install --frozen-lockfile --filter @pressfleet/connector
COPY wp/plugins/pressfleet-connector wp/plugins/pressfleet-connector
RUN pnpm --filter @pressfleet/connector build

FROM wordpress:7.1.3-php8.4-apache
COPY --from=wordpress:cli-2.12.0-php8.4 /usr/local/bin/wp /usr/local/bin/wp
RUN apt-get update \
  && apt-get install -y --no-install-recommends mariadb-client \
  && rm -rf /var/lib/apt/lists/*
# A few Apache workers per site instead of up to 150: three sites share a small server
COPY infra/wordpress/prefork.conf /etc/apache2/conf-enabled/pressfleet-prefork.conf

# The image copies /usr/src/wordpress into the site on first start; the deploy starts each site fresh, so a new
# plugin or theme version replaces the old one while uploads (a volume) and the database stay
ARG PLUGIN=/usr/src/wordpress/wp-content/plugins/pressfleet-connector
COPY --chown=www-data:www-data wp/plugins/pressfleet-connector/pressfleet-connector.php \
  wp/plugins/pressfleet-connector/readme.txt wp/plugins/pressfleet-connector/uninstall.php $PLUGIN/
COPY --chown=www-data:www-data wp/plugins/pressfleet-connector/includes $PLUGIN/includes
COPY --from=block --chown=www-data:www-data /repo/wp/plugins/pressfleet-connector/build $PLUGIN/build
COPY --chown=www-data:www-data wp/themes/pressfleet-theme /usr/src/wordpress/wp-content/themes/pressfleet-theme
RUN rm -f /usr/src/wordpress/wp-content/themes/pressfleet-theme/phpcs.xml.dist

COPY --chmod=755 infra/wordpress/entrypoint.sh /usr/local/bin/pressfleet-entrypoint.sh
ENTRYPOINT ["pressfleet-entrypoint.sh"]
CMD ["apache2-foreground"]

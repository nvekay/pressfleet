# Admin password of the three local demo sites (infra/provision.sh)
WP_ADMIN_PASSWORD=

# Hub API (apps/api)
DATABASE_URL=postgres://pressfleet:pressfleet@localhost:5435/pressfleet
REDIS_URL=redis://localhost:6380
# Shared between the dashboard's server and the API; generate with: openssl rand -base64 24
API_INTERNAL_KEY=
# Encrypts site credentials at rest; 32 bytes in base64: openssl rand -base64 32
SECRETS_KEY=
API_URL=http://localhost:4000

NEXT_PUBLIC_GITHUB_URL=

# Sample dataset for campaigns, and where the WordPress sites download its images from (the dashboard)
SAMPLE_CSV_URL=http://localhost:3000/samples/health-network.csv
SAMPLE_ASSETS_URL=http://host.docker.internal:3000
# Public demo restrictions (only the sample, no site changes, nightly reset)
DEMO_MODE=false
# New leads go to this Telegram chat when both are set
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

{
  "name": "@pressfleet/connector",
  "version": "0.1.0",
  "private": true,
  "description": "PressFleet Connector WordPress plugin: integration tests in wp-env and the Lead form block build",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "wp-scripts build --experimental-modules",
    "start": "wp-scripts start --experimental-modules",
    "lint:js": "wp-scripts lint-js src",
    "env": "wp-env",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/pressfleet-connector vendor/bin/phpunit"
  },
  "devDependencies": {
    "@wordpress/block-editor": "18.0.0",
    "@wordpress/blocks": "16.1.0",
    "@wordpress/components": "41.0.0",
    "@wordpress/env": "11.17.0",
    "@wordpress/i18n": "6.29.0",
    "@wordpress/interactivity": "6.56.0",
    "@wordpress/scripts": "36.1.0"
  }
}

{
  "name": "nvekay/pressfleet-connector",
  "description": "Receives posts from the PressFleet hub over a signed REST API.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse --memory-limit=1G --no-progress",
    "test": "phpunit",
    "lint:theme:fix": "phpcbf --standard=../../themes/pressfleet-theme/phpcs.xml.dist ../../themes/pressfleet-theme",
    "lint:theme": "phpcs --standard=../../themes/pressfleet-theme/phpcs.xml.dist ../../themes/pressfleet-theme"
  },
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^9.6",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.4",
    "yoast/phpunit-polyfills": "^4.0"
  }
}
